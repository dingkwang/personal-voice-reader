# Separate values for development, preview and production. No NEXT_PUBLIC secrets.
APP_ENV=development
RESOURCE_ENV=development
APP_BASE_URL=http://localhost:3000

# Neon from Vercel Marketplace. Use pooled TLS connection in Vercel.
DATABASE_URL=
EXPECTED_DATABASE_HOST=
MIGRATION_PROJECT_SLUG=personal-voice-reader

# Private Vercel Blob. Browser upload tokens require the read-write credential.
BLOB_READ_WRITE_TOKEN=
EXPECTED_BLOB_STORE_ID=

# Auth0 Regular Web Application, static base URL, no wildcard callbacks.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Exactly 64 random hexadecimal characters. Different per environment.
AUTH0_SECRET=
AUTH0_OWNER_SUB=
# Auth0 custom API identifier, normally https://<stable-host>/api/mcp
AUTH0_AUDIENCE=
# Separate manually registered ChatGPT OAuth client, not the web client.
AUTH0_MCP_CLIENT_ID=

# Keep the existing Fish reference inside imported voice metadata, never reclone.
# DEFAULT_VOICE_ID is the app's local voice_* ID, NOT a Fish reference ID.
DEFAULT_VOICE_ID=
FISH_API_KEY=
# FISH_AUDIO_API_KEY is still supported.
FISH_TTS_MODEL=s2-pro
CRON_SECRET=

# One-time migration only, never put access tokens in command arguments.
# LEGACY_BACKUP_DIR=/absolute/repo/.backups/legacy-<timestamp>/data
# OWNER_VERIFIED_BASE_URL=https://<verified-production-host>
# MIGRATION_OWNER_ACCESS_TOKEN=
# MIGRATION_PROBE_ID=

# Optional web-only IndexTTS-2.5 service (Modal Proxy Tokens, server only).
# The web default is stored per owner in reader_preferences; MCP keeps DEFAULT_VOICE_ID.
INDEXTTS_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
