# Create a key at https://fish.audio/app/api-keys/
FISH_API_KEY=

# Optional: use a cloned or public Fish voice as the default selection.
FISH_DEFAULT_VOICE_ID=
FISH_DEFAULT_VOICE_NAME=我的声音

# The current Fish recommendation. The adapter also accepts s1.
FISH_TTS_MODEL=s2-pro

# Optional absolute directory for JSON metadata and cached MP3 files.
# VOICE_READER_DATA_DIR=/var/lib/personal-voice-reader
